# Copia questo file come .env e adatta i valori.

SECRET_KEY=cambia-questa-chiave-lunga-e-casuale
DEBUG=False

# Host da cui si apre l'app (IP del server e/o nome)
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.10

# Se usi http://IP:8000 dalla rete, elenca le origini CSRF (con schema)
# CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8000,http://labrepair.locale

# PostgreSQL
DATABASE_URL=postgres://utente:password@127.0.0.1:5432/labrepair

LANGUAGE_CODE=it-it
TIME_ZONE=Europe/Rome

# True solo se c'è HTTPS (certificato / reverse proxy)
USE_HTTPS=False

# In LAN senza IIS/nginx lascia True (foto e allegati)
SERVE_MEDIA=True

# False = lettore Bit4id sul PC client (agent locale http://127.0.0.1:17345)
# True  = lettore collegato al server
CIE_READER_ON_SERVER=False
